      "rdfs:range": {
        "@id": "xsd:string"
      }
    },
    {
      "@id": "pilot:SequencingRun",
      "@type": "owl:Class",
      "rdfs:comment": [
        "Design status: source-grounded",
        {
          "@language": "vi",
          "@value": "Một run SRA; khác patient, specimen và assay."
