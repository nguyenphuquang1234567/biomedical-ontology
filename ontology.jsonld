        "@id": "pilot:SourceAsset"
      },
      "rdfs:label": "sourceInStudy",
      "rdfs:range": {
        "@id": "pilot:Study"
      }
    },
    {
      "@id": "pilot:ClassificationCode",
      "@type": "owl:Class",
      "rdfs:comment": {
        "@language": "en",
        "@value": "A reported patent classification code, preserving the source classification field."
      },
      "rdfs:label": "ClassificationCode",
      "rdfs:subClassOf": {
        "@id": "pilot:Entity"
      }
    },
    {
      "@id": "pilot:GrantAward",
      "@type": "owl:Class",
      "rdfs:comment": {
        "@language": "en",
        "@value": "An award record keyed by award_key; not a Study or an individual annual funding record."
      },
      "rdfs:label": "GrantAward",
      "rdfs:subClassOf": {
        "@id": "pilot:Entity"
      }
    },
    {
      "@id": "pilot:qualityOf",
      "@type": "owl:ObjectProperty",
      "rdfs:comment": {
        "@language": "vi",
        "@value": "QC của run/asset/pipeline"
