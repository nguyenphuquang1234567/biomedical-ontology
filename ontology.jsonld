{
  "@context": {
    "owl": "http://www.w3.org/2002/07/owl#",
    "pilot": "https://example.org/nih-pilot/ontology/",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "xsd": "http://www.w3.org/2001/XMLSchema#"
  },
  "@graph": [
    {
      "@id": "pilot:GeneCountResult",
      "@type": "owl:Class",
      "rdfs:comment": [
        "Design status: source-grounded",
        {
          "@language": "vi",
          "@value": "Count gắn gene và người/mẫu; không phải số bản sao gene trong DNA."
        }
      ],
      "rdfs:label": {
        "@language": "en",
        "@value": "Gene Count Result"
      },
      "rdfs:seeAlso": [
        {
          "@id": "https://datadryad.org/dataset/doi:10.5061/dryad.800tj"
        },
        {
          "@id": "https://www.nature.com/articles/s41597-025-06171-6"
        }
      ],
      "rdfs:subClassOf": {
        "@id": "pilot:Result"
      }
    },
    {
      "@id": "pilot:metadataJson",
      "@type": "owl:DatatypeProperty",
      "rdfs:comment": {
        "@language": "vi",
        "@value": "JSON nguyên bản cho các metadata chưa chuẩn hóa; không coi là ontology đã giải nghĩa"
      },
      "rdfs:range": {
        "@id": "xsd:string"
      }
    },
    {
      "@id": "pilot:CNVResult",
      "@type": "owl:Class",
      "rdfs:comment": [
        "Design status: source-grounded",
        {
          "@language": "vi",
          "@value": "Feature CNV hoặc tumor fraction dẫn xuất; không phải gene expression."
        }
      ],
      "rdfs:label": {
        "@language": "en",
        "@value": "C N V Result"
      },
      "rdfs:seeAlso": {
        "@id": "https://www.nature.com/articles/s41597-025-06171-6"
      },
      "rdfs:subClassOf": {
        "@id": "pilot:Result"
      }
    },
    {
      "@id": "pilot:citingDocument",
      "@type": "owl:ObjectProperty",
      "rdfs:comment": {
        "@language": "vi",
        "@value": "Bài chứa trích dẫn"
      },
      "rdfs:domain": {
        "@id": "pilot:Citation"
      },
      "rdfs:label": "citingDocument",
      "rdfs:range": {
        "@id": "pilot:Document"
      }
    },
    {
      "@id": "pilot:GrantDocument",
      "@type": "owl:Class",
      "rdfs:comment": {
        "@language": "en",
        "@value": "A grant project-detail record or abstract; not a claim that full grant text is available."
      },
      "rdfs:label": "GrantDocument",
      "rdfs:subClassOf": {
        "@id": "pilot:Document"
      }
    },
    {
      "@id": "pilot:endTime",
      "@type": "owl:DatatypeProperty",
      "rdfs:comment": {
        "@language": "vi",
        "@value": "Thời điểm kết thúc"
      },
      "rdfs:range": {
        "@id": "xsd:dateTime"
      }
    },
    {
      "@id": "pilot:documentForFunding",
      "@type": "owl:ObjectProperty",
      "rdfs:comment": {
        "@language": "en",
        "@value": "Project-detail/abstract document associated with the application record."
      },
      "rdfs:domain": {
        "@id": "pilot:GrantDocument"
      },
      "rdfs:range": {
        "@id": "pilot:GrantFundingRecord"
      }
    },
    {
      "@id": "pilot:statisticForGroup",
      "@type": "owl:ObjectProperty",
      "rdfs:comment": {
        "@language": "vi",
        "@value": "Thống kê cho nhóm"
      },
      "rdfs:domain": {
        "@id": "pilot:AggregateStatistic"
      },
      "rdfs:label": "statisticForGroup",
      "rdfs:range": {
        "@id": "pilot:CohortGroup"
      }
    },
    {
      "@id": "pilot:hasIdentifier",
      "@type": "owl:ObjectProperty",
      "rdfs:comment": {
        "@language": "vi",
        "@value": "Entity có mã external"
      },
      "rdfs:domain": {
        "@id": "pilot:Entity"
      },
      "rdfs:label": "hasIdentifier",
      "rdfs:range": {
        "@id": "pilot:Identifier"
      }
    },
    {
      "@id": "pilot:Study",
      "@type": "owl:Class",
      "rdfs:comment": [
        "Design status: source-grounded",
        {
          "@language": "vi",
          "@value": "Nghiên cứu/cohort; không đồng nhất với repository hay bài báo."
        }
      ],
      "rdfs:label": {
        "@language": "en",
        "@value": "Study"
      },
      "rdfs:seeAlso": [
        {
          "@id": "https://datadryad.org/dataset/doi:10.5061/dryad.800tj"
        },
