          "@id": "https://link.springer.com/article/10.1186/s12879-022-07381-8"
        },
        {
          "@id": "https://www.frontiersin.org/journals/medicine/articles/10.3389/fmed.2023.1195629/full"
        },
        {
          "@id": "https://www.nature.com/articles/s41597-025-06171-6"
        }
      ],
      "rdfs:subClassOf": {
        "@id": "pilot:Entity"
      }
    },
    {
      "@id": "pilot:DiagnosticPerformanceStatistic",
      "@type": "owl:Class",
      "rdfs:comment": [
        "Design status: source-grounded",
        {
          "@language": "vi",
          "@value": "Sensitivity/specificity hoặc bảng đồng thuận; giữ reference standard."
        }
      ],
      "rdfs:label": {
        "@language": "en",
        "@value": "Diagnostic Performance Statistic"
      },
      "rdfs:seeAlso": [
        {
          "@id": "https://link.springer.com/article/10.1186/s12879-022-07381-8"
        },
        {
          "@id": "https://www.frontiersin.org/journals/medicine/articles/10.3389/fmed.2023.1195629/full"
        }
      ],
      "rdfs:subClassOf": {
        "@id": "pilot:AggregateStatistic"
      }
    },
    {
      "@id": "pilot:",
      "@type": "owl:Ontology",
      "owl:versionInfo": "0.3.0-draft",
      "rdfs:comment": "Draft union ontology based on inspected local assets of five Table 1 sources. Namespace is provisional; no external biomedical equivalences asserted."
    },
    {
      "@id": "pilot:recipientOrganization",
      "@type": "owl:ObjectProperty",
      "rdfs:comment": {
        "@language": "en",
        "@value": "Reported recipient organization, without assuming affiliation of every named person."
      },
      "rdfs:domain": {
        "@id": "pilot:GrantAward"
      },
      "rdfs:range": {
        "@id": "pilot:Organization"
      }
    },
    {
      "@id": "pilot:extractionConfidence",
      "@type": "owl:DatatypeProperty",
      "rdfs:comment": {
        "@language": "vi",
        "@value": "Độ tin cậy extraction nếu đo được; không bịa score"
      },
      "rdfs:range": {
        "@id": "xsd:double"
      }
    },
    {
      "@id": "pilot:matchedTaxonReference",
      "@type": "owl:ObjectProperty",
      "rdfs:comment": {
        "@language": "en",
        "@value": "Source reference; no verified taxonomic entity or claim-support relation is inferred."
      },
      "rdfs:domain": {
        "@id": "pilot:RetrievalMatch"
      },
      "rdfs:range": {
        "@id": "pilot:TaxonReference"
      }
    },
    {
      "@id": "pilot:denominator",
      "@type": "owl:DatatypeProperty",
      "rdfs:comment": {
        "@language": "vi",
        "@value": "Mẫu số thống kê"
      },
      "rdfs:range": {
        "@id": "xsd:integer"
      }
    },
    {
      "@id": "pilot:namespace",
      "@type": "owl:DatatypeProperty",
      "rdfs:comment": {
        "@language": "vi",
        "@value": "Namespace mã"
      },
      "rdfs:range": {
        "@id": "xsd:string"
      }
    },
    {
      "@id": "pilot:Treatment",
      "@type": "owl:Class",
      "rdfs:comment": [
        "Design status: source-grounded",
        {
          "@language": "vi",
          "@value": "Khái niệm điều trị dùng chung; không phải sự kiện điều trị từng người."
        }
      ],
      "rdfs:label": {
        "@language": "en",
        "@value": "Treatment"
      },
      "rdfs:seeAlso": [
        {
          "@id": "https://link.springer.com/article/10.1186/s12879-022-07381-8"
        },
        {
          "@id": "https://www.frontiersin.org/journals/medicine/articles/10.3389/fmed.2023.1195629/full"
        }
      ],
      "rdfs:subClassOf": {
        "@id": "pilot:Entity"
      }
    },
    {
      "@id": "pilot:primaryExaminerMention",
      "@type": "owl:ObjectProperty",
      "rdfs:comment": {
        "@language": "en",
        "@value": "Primary examiner text as reported."
      },
      "rdfs:domain": {
        "@id": "pilot:Patent"
      },
      "rdfs:range": {
        "@id": "pilot:PersonNameMention"
      }
    },
    {
      "@id": "pilot:producedByTest",
      "@type": "owl:ObjectProperty",
      "rdfs:comment": {
        "@language": "vi",
        "@value": "Kết quả của xét nghiệm"
      },
      "rdfs:domain": {
        "@id": "pilot:Result"
      },
      "rdfs:label": "producedByTest",
      "rdfs:range": {
        "@id": "pilot:Test"
      }
    },
    {
      "@id": "pilot:evidenceSection",
      "@type": "owl:ObjectProperty",
      "rdfs:comment": {
        "@language": "vi",
        "@value": "Section chứa evidence"
      },
      "rdfs:domain": {
        "@id": "pilot:EvidenceUnit"
      },
      "rdfs:label": "evidenceSection",
      "rdfs:range": {
        "@id": "pilot:DocumentSection"
      }
    },
    {
      "@id": "pilot:resultStatus",
      "@type": "owl:DatatypeProperty",
      "rdfs:comment": {
        "@language": "vi",
        "@value": "detected/negative/not_performed/not_collected/not_reported/unknown; zero là giá trị riêng"
      },
      "rdfs:range": {
        "@id": "xsd:string"
      }
    },
    {
      "@id": "pilot:assessmentStage",
      "@type": "owl:DatatypeProperty",
      "rdfs:comment": {
        "@language": "vi",
        "@value": "initial/interim/final/unknown; chỉ gán nếu xác minh"
      },
      "rdfs:range": {
        "@id": "xsd:string"
      }
    },
    {
      "@id": "pilot:linkClaim",
      "@type": "owl:ObjectProperty",
      "rdfs:comment": {
        "@language": "vi",
        "@value": "Liên kết evidence dành cho claim"
      },
      "rdfs:domain": {
        "@id": "pilot:EvidenceLink"
      },
      "rdfs:label": "linkClaim",
      "rdfs:range": {
        "@id": "pilot:Claim"
      }
    },
    {
      "@id": "pilot:country",
      "@type": "owl:DatatypeProperty",
      "rdfs:comment": {
        "@language": "en",
        "@value": "Reported country; not inferred from other fields."
      },
      "rdfs:range": {
        "@id": "xsd:string"
      }
    },
    {
      "@id": "pilot:sourceInStudy",
      "@type": "owl:ObjectProperty",
