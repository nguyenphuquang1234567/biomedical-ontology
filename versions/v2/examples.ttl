    pilot:mappingStatus "unmapped" .

<https://example.org/nih-pilot/data/D1/study> a pilot:Study ;
    pilot:label "Dryad 10.5061/dryad.800tj" .

<https://example.org/nih-pilot/data/D2/locator/table2patient10> a pilot:SourceLocator ;
    pilot:locatedIn <https://example.org/nih-pilot/data/D2/asset/table2> ;
