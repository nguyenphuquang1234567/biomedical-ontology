<https://example.org/nih-pilot/data/D2/locator/patient10mngs> a pilot:SourceLocator ;
    pilot:locatedIn <https://example.org/nih-pilot/data/D2/asset/supplement> ;
    pilot:locator "Sheet1!E12; patient=10" ;
    pilot:rawText "Torque teno virus_5" .

<https://example.org/nih-pilot/data/gene/ensembl/ENSG00000000003> a pilot:Gene ;
