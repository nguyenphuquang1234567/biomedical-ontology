@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix pilot: <https://example.org/nih-pilot/ontology/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

pilot: a owl:Ontology ;
    rdfs:comment "Draft union ontology based on inspected local assets of five Table 1 sources. Namespace is provisional; no external biomedical equivalences asserted." ;
    owl:versionInfo "0.3.0-draft" .

pilot:AntigenTest a owl:Class ;
    rdfs:label "Antigen Test"@en ;
    rdfs:comment "Design status: source-grounded",
        "Ví dụ galactomannan; không tự đồng nhất với PCR."@vi ;
    rdfs:seeAlso <https://www.frontiersin.org/journals/medicine/articles/10.3389/fmed.2023.1195629/full> ;
    rdfs:subClassOf pilot:ConventionalMicrobiologyTest .

pilot:BALSpecimen a owl:Class ;
    rdfs:label "B A L Specimen"@en ;
    rdfs:comment "Design status: source-grounded",
        "Mẫu dịch rửa phế quản-phế nang."@vi ;
    rdfs:seeAlso <https://datadryad.org/dataset/doi:10.5061/dryad.800tj>,
        <https://link.springer.com/article/10.1186/s12879-022-07381-8>,
        <https://www.frontiersin.org/journals/medicine/articles/10.3389/fmed.2023.1195629/full>,
        <https://www.nature.com/articles/s41597-025-06171-6> ;
    rdfs:subClassOf pilot:Specimen .

pilot:Bacterium a owl:Class ;
    rdfs:label "Bacterium"@en ;
    rdfs:comment "Design status: source-grounded",
        "Taxon vi khuẩn khi có phân loại được xác minh."@vi ;
    rdfs:seeAlso <https://link.springer.com/article/10.1186/s12879-022-07381-8>,
        <https://www.frontiersin.org/journals/medicine/articles/10.3389/fmed.2023.1195629/full>,
        <https://www.nature.com/articles/s41597-025-06171-6> ;
    rdfs:subClassOf pilot:Organism .

pilot:BloodSpecimen a owl:Class ;
    rdfs:label "Blood Specimen"@en ;
    rdfs:comment "Design status: source-grounded",
        "Mẫu máu được mô tả ở methods; chưa có liên kết từng người từ methods."@vi ;
    rdfs:seeAlso <https://www.frontiersin.org/journals/medicine/articles/10.3389/fmed.2023.1195629/full> ;
    rdfs:subClassOf pilot:Specimen .

pilot:CARTTreatmentEvent a owl:Class ;
    rdfs:label "C A R T Treatment Event"@en ;
    rdfs:comment "Design status: source-grounded",
        "Sự kiện CAR-T được mô tả trong nguồn."@vi ;
    rdfs:seeAlso <https://www.frontiersin.org/journals/medicine/articles/10.3389/fmed.2023.1195629/full> ;
    rdfs:subClassOf pilot:TreatmentEvent .

pilot:CNVResult a owl:Class ;
    rdfs:label "C N V Result"@en ;
    rdfs:comment "Design status: source-grounded",
        "Feature CNV hoặc tumor fraction dẫn xuất; không phải gene expression."@vi ;
    rdfs:seeAlso <https://www.nature.com/articles/s41597-025-06171-6> ;
    rdfs:subClassOf pilot:Result .

pilot:CellType a owl:Class ;
    rdfs:label "Cell Type"@en ;
    rdfs:comment "Design status: source-grounded",
        "Loại tế bào được pipeline ước lượng."@vi ;
    rdfs:seeAlso <https://www.nature.com/articles/s41597-025-06171-6> ;
    rdfs:subClassOf pilot:Feature .

pilot:CellTypeScoreResult a owl:Class ;
    rdfs:label "Cell Type Score Result"@en ;
    rdfs:comment "Design status: source-grounded",
        "Score cell type CIBERSORTx; không tự xem là phần trăm."@vi ;
    rdfs:seeAlso <https://www.nature.com/articles/s41597-025-06171-6> ;
    rdfs:subClassOf pilot:Result .

pilot:ChromosomalFeature a owl:Class ;
    rdfs:label "Chromosomal Feature"@en ;
    rdfs:comment "Design status: source-grounded",
        "Feature nhiễm sắc thể/CNV."@vi ;
    rdfs:seeAlso <https://www.nature.com/articles/s41597-025-06171-6> ;
    rdfs:subClassOf pilot:Feature .

pilot:CoverageResult a owl:Class ;
    rdfs:label "Coverage Result"@en ;
    rdfs:comment "Design status: source-grounded",
        "Độ bao phủ; cần định nghĩa metric và đơn vị từ nguồn."@vi ;
    rdfs:seeAlso <https://link.springer.com/article/10.1186/s12879-022-07381-8> ;
    rdfs:subClassOf pilot:Result .

pilot:CultureTest a owl:Class ;
    rdfs:label "Culture Test"@en ;
    rdfs:comment "Design status: source-grounded",
        "Nuôi cấy vi khuẩn/nấm được nêu ở methods."@vi ;
    rdfs:seeAlso <https://www.frontiersin.org/journals/medicine/articles/10.3389/fmed.2023.1195629/full> ;
    rdfs:subClassOf pilot:ConventionalMicrobiologyTest .

pilot:DataMatrix a owl:Class ;
    rdfs:label "Data Matrix"@en ;
    rdfs:comment "Design status: source-grounded",
        "Ma trận có hướng hàng/cột, namespace feature và modality."@vi ;
    rdfs:seeAlso <https://datadryad.org/dataset/doi:10.5061/dryad.800tj>,
        <https://www.nature.com/articles/s41597-025-06171-6> ;
    rdfs:subClassOf pilot:SourceAsset .

pilot:DiagnosticPerformanceStatistic a owl:Class ;
    rdfs:label "Diagnostic Performance Statistic"@en ;
    rdfs:comment "Design status: source-grounded",
        "Sensitivity/specificity hoặc bảng đồng thuận; giữ reference standard."@vi ;
    rdfs:seeAlso <https://link.springer.com/article/10.1186/s12879-022-07381-8>,
        <https://www.frontiersin.org/journals/medicine/articles/10.3389/fmed.2023.1195629/full> ;
    rdfs:subClassOf pilot:AggregateStatistic .

pilot:DrugTreatmentEvent a owl:Class ;
    rdfs:label "Drug Treatment Event"@en ;
    rdfs:comment "Design status: source-grounded",
        "Điều trị bằng thuốc; giữ nguyên ý nghĩa kê đơn/đã dùng nếu nguồn có."@vi ;
    rdfs:seeAlso <https://www.frontiersin.org/journals/medicine/articles/10.3389/fmed.2023.1195629/full> ;
    rdfs:subClassOf pilot:TreatmentEvent .

pilot:FigureEvidence a owl:Class ;
    rdfs:label "Figure Evidence"@en ;
    rdfs:comment "Design status: source-grounded",
        "Hình/caption; chưa đồng nghĩa đã extract giá trị ảnh."@vi ;
    rdfs:seeAlso <https://pmc.ncbi.nlm.nih.gov/tools/openftlist/> ;
    rdfs:subClassOf pilot:EvidenceUnit .

pilot:FindingClaim a owl:Class ;
    rdfs:label "Finding Claim"@en ;
    rdfs:comment "Design status: design",
        "Phát biểu về kết quả nghiên cứu."@vi ;
    rdfs:seeAlso <https://pmc.ncbi.nlm.nih.gov/tools/openftlist/> ;
    rdfs:subClassOf pilot:Claim .

pilot:Fungus a owl:Class ;
    rdfs:label "Fungus"@en ;
    rdfs:comment "Design status: source-grounded",
        "Taxon nấm khi có phân loại được xác minh."@vi ;
    rdfs:seeAlso <https://link.springer.com/article/10.1186/s12879-022-07381-8>,
        <https://www.frontiersin.org/journals/medicine/articles/10.3389/fmed.2023.1195629/full>,
        <https://www.nature.com/articles/s41597-025-06171-6> ;
    rdfs:subClassOf pilot:Organism .

pilot:Gene a owl:Class ;
    rdfs:label "Gene"@en ;
    rdfs:comment "Design status: source-grounded",
        "Gene concept; ENSG và gene symbol chưa được coi tương đương khi chưa mapping."@vi ;
    rdfs:seeAlso <https://datadryad.org/dataset/doi:10.5061/dryad.800tj>,
        <https://www.nature.com/articles/s41597-025-06171-6> ;
    rdfs:subClassOf pilot:Feature .

pilot:GeneCountResult a owl:Class ;
    rdfs:label "Gene Count Result"@en ;
    rdfs:comment "Design status: source-grounded",
        "Count gắn gene và người/mẫu; không phải số bản sao gene trong DNA."@vi ;
    rdfs:seeAlso <https://datadryad.org/dataset/doi:10.5061/dryad.800tj>,
        <https://www.nature.com/articles/s41597-025-06171-6> ;
    rdfs:subClassOf pilot:Result .

pilot:HostTranscriptomeTest a owl:Class ;
    rdfs:label "Host Transcriptome Test"@en ;
    rdfs:comment "Design status: source-grounded",
        "Assay/processing tạo biểu hiện gene chủ; cần chứng cứ về mẫu và pipeline."@vi ;
    rdfs:seeAlso <https://datadryad.org/dataset/doi:10.5061/dryad.800tj>,
        <https://www.nature.com/articles/s41597-025-06171-6> ;
    rdfs:subClassOf pilot:SequencingTest .

pilot:Hypothesis a owl:Class ;
    rdfs:label "Hypothesis"@en ;
    rdfs:comment "Design status: design",
        "Giả thuyết của bài; không phải fact được xác nhận."@vi ;
    rdfs:seeAlso <https://pmc.ncbi.nlm.nih.gov/tools/openftlist/> ;
    rdfs:subClassOf pilot:Claim .

pilot:ImagingFinding a owl:Class ;
    rdfs:label "Imaging Finding"@en ;
    rdfs:comment "Design status: source-grounded",
        "Mô tả hình ảnh phổi; không tự coi là kết quả vi sinh."@vi ;
    rdfs:seeAlso <https://www.frontiersin.org/journals/medicine/articles/10.3389/fmed.2023.1195629/full> ;
    rdfs:subClassOf pilot:ClinicalEvent .

pilot:LaboratoryAnalyte a owl:Class ;
    rdfs:label "Laboratory Analyte"@en ;
    rdfs:comment "Design status: source-grounded",
        "Chỉ số xét nghiệm như WBC, ANC, CRP, PCT."@vi ;
    rdfs:seeAlso <https://www.frontiersin.org/journals/medicine/articles/10.3389/fmed.2023.1195629/full> ;
    rdfs:subClassOf pilot:Feature .

pilot:LaboratoryResult a owl:Class ;
    rdfs:label "Laboratory Result"@en ;
    rdfs:comment "Design status: source-grounded",
        "Kết quả chỉ số như WBC/ANC nếu có giá trị cá nhân; số nhóm lưu AggregateStatistic."@vi ;
    rdfs:seeAlso <https://www.frontiersin.org/journals/medicine/articles/10.3389/fmed.2023.1195629/full> ;
    rdfs:subClassOf pilot:Result .

pilot:LaboratoryTest a owl:Class ;
    rdfs:label "Laboratory Test"@en ;
    rdfs:comment "Design status: source-grounded",
        "Xét nghiệm chỉ số xét nghiệm; có thể mới được mô tả ở cấp nhóm."@vi ;
    rdfs:seeAlso <https://www.frontiersin.org/journals/medicine/articles/10.3389/fmed.2023.1195629/full> ;
    rdfs:subClassOf pilot:Test .

pilot:MNGSTest a owl:Class ;
    rdfs:label "M N G S Test"@en ;
    rdfs:comment "Design status: source-grounded",
        "Assay metagenomic next-generation sequencing."@vi ;
    rdfs:seeAlso <https://link.springer.com/article/10.1186/s12879-022-07381-8>,
        <https://www.frontiersin.org/journals/medicine/articles/10.3389/fmed.2023.1195629/full>,
        <https://www.nature.com/articles/s41597-025-06171-6> ;
    rdfs:subClassOf pilot:SequencingTest .

pilot:MethodClaim a owl:Class ;
    rdfs:label "Method Claim"@en ;
    rdfs:comment "Design status: design",
        "Phát biểu về phương pháp nghiên cứu."@vi ;
    rdfs:seeAlso <https://pmc.ncbi.nlm.nih.gov/tools/openftlist/> ;
    rdfs:subClassOf pilot:Claim .

pilot:MicrobialDetection a owl:Class ;
    rdfs:label "Microbial Detection"@en ;
    rdfs:comment "Design status: source-grounded",
        "Phát hiện tác nhân/taxon; chưa đồng nghĩa gây bệnh."@vi ;
    rdfs:seeAlso <https://link.springer.com/article/10.1186/s12879-022-07381-8>,
        <https://www.frontiersin.org/journals/medicine/articles/10.3389/fmed.2023.1195629/full>,
        <https://www.nature.com/articles/s41597-025-06171-6> ;
    rdfs:subClassOf pilot:Result .

pilot:MicroscopyTest a owl:Class ;
    rdfs:label "Microscopy Test"@en ;
    rdfs:comment "Design status: source-grounded",
        "Soi/smear microscopy được nêu trong methods."@vi ;
    rdfs:seeAlso <https://www.frontiersin.org/journals/medicine/articles/10.3389/fmed.2023.1195629/full> ;
    rdfs:subClassOf pilot:ConventionalMicrobiologyTest .

pilot:PCRTest a owl:Class ;
    rdfs:label "P C R Test"@en ;
    rdfs:comment "Design status: source-grounded",
        "PCR được mô tả trong methods; chỉ gán cá nhân khi có kết quả tương ứng."@vi ;
    rdfs:seeAlso <https://www.frontiersin.org/journals/medicine/articles/10.3389/fmed.2023.1195629/full> ;
    rdfs:subClassOf pilot:ConventionalMicrobiologyTest .

pilot:PleuralFluidSpecimen a owl:Class ;
    rdfs:label "Pleural Fluid Specimen"@en ;
    rdfs:comment "Design status: source-grounded",
        "Mẫu dịch màng phổi nêu trong methods; không tự tạo specimen cá nhân."@vi ;
    rdfs:seeAlso <https://www.frontiersin.org/journals/medicine/articles/10.3389/fmed.2023.1195629/full> ;
    rdfs:subClassOf pilot:Specimen .

pilot:QualityMetric a owl:Class ;
    rdfs:label "Quality Metric"@en ;
    rdfs:comment "Design status: source-grounded",
        "Đại lượng QC như Q20, GC, correlation và RMSE."@vi ;
    rdfs:seeAlso <https://www.nature.com/articles/s41597-025-06171-6> ;
    rdfs:subClassOf pilot:Feature .

pilot:SwabSpecimen a owl:Class ;
    rdfs:label "Swab Specimen"@en ;
    rdfs:comment "Design status: source-grounded",
        "Mẫu swab nêu trong methods; giữ nguyên loại nguồn, không tự sửa vị trí lấy."@vi ;
    rdfs:seeAlso <https://www.frontiersin.org/journals/medicine/articles/10.3389/fmed.2023.1195629/full> ;
    rdfs:subClassOf pilot:Specimen .

pilot:SymptomOccurrence a owl:Class ;
    rdfs:label "Symptom Occurrence"@en ;
    rdfs:comment "Design status: source-grounded",
        "Ghi nhận triệu chứng như sốt, ho, khó thở."@vi ;
    rdfs:seeAlso <https://www.frontiersin.org/journals/medicine/articles/10.3389/fmed.2023.1195629/full> ;
    rdfs:subClassOf pilot:ClinicalEvent .

pilot:TableEvidence a owl:Class ;
    rdfs:label "Table Evidence"@en ;
    rdfs:comment "Design status: source-grounded",
        "Bảng hoặc vùng ô; có header và phạm vi."@vi ;
    rdfs:seeAlso <https://pmc.ncbi.nlm.nih.gov/tools/openftlist/> ;
    rdfs:subClassOf pilot:EvidenceUnit .

pilot:TaxonAbundanceResult a owl:Class ;
    rdfs:label "Taxon Abundance Result"@en ;
    rdfs:comment "Design status: source-grounded",
        "Abundance theo taxon; giữ công thức/đơn vị chưa biết."@vi ;
    rdfs:seeAlso <https://www.nature.com/articles/s41597-025-06171-6> ;
    rdfs:subClassOf pilot:Result .

pilot:TextEvidence a owl:Class ;
    rdfs:label "Text Evidence"@en ;
    rdfs:comment "Design status: source-grounded",
        "Đoạn văn có vị trí trong phiên bản tài liệu."@vi ;
    rdfs:seeAlso <https://pmc.ncbi.nlm.nih.gov/tools/openftlist/> ;
    rdfs:subClassOf pilot:EvidenceUnit .

pilot:TransplantEvent a owl:Class ;
    rdfs:label "Transplant Event"@en ;
    rdfs:comment "Design status: source-grounded",
        "Sự kiện HCT/HSCT khi có ghi nhận; không tự điền ngày."@vi ;
    rdfs:seeAlso <https://www.frontiersin.org/journals/medicine/articles/10.3389/fmed.2023.1195629/full> ;
    rdfs:subClassOf pilot:TreatmentEvent .

pilot:Virus a owl:Class ;
    rdfs:label "Virus"@en ;
    rdfs:comment "Design status: source-grounded",
        "Taxon virus; ví dụ TTV, HHV6B trong nguồn."@vi ;
    rdfs:seeAlso <https://link.springer.com/article/10.1186/s12879-022-07381-8>,
        <https://www.frontiersin.org/journals/medicine/articles/10.3389/fmed.2023.1195629/full> ;
    rdfs:subClassOf pilot:Organism .

pilot:abstractText a owl:DatatypeProperty ;
    rdfs:comment "Original abstract text, not an extracted Claim or full grant document."@en ;
    rdfs:range xsd:string .

pilot:accession a owl:DatatypeProperty ;
    rdfs:comment "Accession nguyên gốc"@vi ;
    rdfs:range xsd:string .

pilot:activityCode a owl:DatatypeProperty ;
    rdfs:comment "Reported grant activity code."@en ;
    rdfs:range xsd:string .

pilot:administeredBy a owl:ObjectProperty ;
    rdfs:comment "Administering institute described by its code and name, distinct from recipient."@en ;
    rdfs:domain pilot:GrantAward ;
    rdfs:range pilot:Organization .

pilot:age a owl:DatatypeProperty ;
    rdfs:comment "Tuổi như nguồn; lưu tuổi cùng thời điểm nếu có"@vi ;
    rdfs:range xsd:decimal .

pilot:applicantMention a owl:ObjectProperty ;
    rdfs:comment "Applicant text as reported; distinct from assignee."@en ;
    rdfs:domain pilot:Patent ;
    rdfs:range pilot:PartyMention .

pilot:assertionObject a owl:ObjectProperty ;
    rdfs:label "assertionObject" ;
    rdfs:comment "Đối tượng phát biểu có nguồn"@vi ;
    rdfs:domain pilot:Assertion ;
    rdfs:range pilot:Entity .

pilot:assertionSource a owl:ObjectProperty ;
    rdfs:label "assertionSource" ;
    rdfs:comment "Vị trí bằng chứng cho phát biểu"@vi ;
    rdfs:domain pilot:Assertion ;
    rdfs:range pilot:SourceLocator .

pilot:assertionSubject a owl:ObjectProperty ;
    rdfs:label "assertionSubject" ;
    rdfs:comment "Chủ thể phát biểu có nguồn"@vi ;
    rdfs:domain pilot:Assertion ;
    rdfs:range pilot:Entity .

pilot:assessmentFor a owl:ObjectProperty ;
    rdfs:label "assessmentFor" ;
    rdfs:comment "Đánh giá dành cho người"@vi ;
    rdfs:domain pilot:ClinicalAssessment ;
    rdfs:range pilot:Patient .

pilot:assessmentMethod a owl:DatatypeProperty ;
    rdfs:comment "Clinician review/reference criteria theo nguồn"@vi ;
    rdfs:range xsd:string .

pilot:assessmentOfEpisode a owl:ObjectProperty ;
    rdfs:label "assessmentOfEpisode" ;
    rdfs:comment "Đánh giá cho đợt bệnh"@vi ;
    rdfs:domain pilot:ClinicalAssessment ;
    rdfs:range pilot:InfectionEpisode .

pilot:assessmentStage a owl:DatatypeProperty ;
    rdfs:comment "initial/interim/final/unknown; chỉ gán nếu xác minh"@vi ;
    rdfs:range xsd:string .

pilot:assigneeMention a owl:ObjectProperty ;
    rdfs:comment "Assignee text as reported; may name an individual or organization."@en ;
    rdfs:domain pilot:Patent ;
    rdfs:range pilot:PartyMention .

pilot:assistantExaminerMention a owl:ObjectProperty ;
    rdfs:comment "Assistant examiner text as reported."@en ;
    rdfs:domain pilot:Patent ;
    rdfs:range pilot:PersonNameMention .

pilot:awardAmount a owl:DatatypeProperty ;
    rdfs:comment "Reported monetary amount, with unknown currency and additive scope unless verified separately."@en ;
    rdfs:range xsd:decimal .

pilot:awardCurrency a owl:DatatypeProperty ;
    rdfs:comment "Only populated when a currency is established by a source; absent here."@en ;
    rdfs:range xsd:string .

pilot:awardNoticeDate a owl:DatatypeProperty ;
    rdfs:comment "Reported notice date; not retrieval time."@en ;
    rdfs:range xsd:date .

pilot:certainty a owl:DatatypeProperty ;
    rdfs:comment "Độ chắc chắn nguồn; không phải extraction confidence"@vi ;
    rdfs:range xsd:string .

pilot:checksum a owl:DatatypeProperty ;
    rdfs:comment "SHA256 của file thực tế"@vi ;
    rdfs:range xsd:string .

pilot:citedDocument a owl:ObjectProperty ;
    rdfs:label "citedDocument" ;
    rdfs:comment "Bài được trích nếu resolve được"@vi ;
    rdfs:domain pilot:Citation ;
    rdfs:range pilot:Document .

pilot:citingDocument a owl:ObjectProperty ;
    rdfs:label "citingDocument" ;
    rdfs:comment "Bài chứa trích dẫn"@vi ;
    rdfs:domain pilot:Citation ;
    rdfs:range pilot:Document .

pilot:city a owl:DatatypeProperty ;
    rdfs:comment "Reported city."@en ;
    rdfs:range xsd:string .

pilot:claimIn a owl:ObjectProperty ;
    rdfs:label "claimIn" ;
    rdfs:comment "Claim được tác giả nêu trong tài liệu"@vi ;
    rdfs:domain pilot:Claim ;
    rdfs:range pilot:Document .

pilot:classificationCode a owl:DatatypeProperty ;
    rdfs:comment "Original reported classification code."@en ;
    rdfs:range xsd:string .

pilot:classificationFilter a owl:DatatypeProperty ;
    rdfs:comment "CPC search filter, distinct from assigned classification."@en ;
    rdfs:range xsd:string .

pilot:classificationScheme a owl:DatatypeProperty ;
    rdfs:comment "Reported classification scheme."@en ;
    rdfs:range xsd:string .

pilot:classificationSourceField a owl:DatatypeProperty ;
    rdfs:comment "CPCI or CPCA as reported; their detailed meanings are not inferred."@en ;
    rdfs:range xsd:string .

pilot:collectionTime a owl:DatatypeProperty ;
    rdfs:comment "Ngày giờ lấy mẫu nếu có"@vi ;
    rdfs:range xsd:dateTime .

pilot:columnAxis a owl:DatatypeProperty ;
    rdfs:comment "Ý nghĩa columns"@vi ;
    rdfs:range xsd:string .

pilot:conditionConcept a owl:ObjectProperty ;
    rdfs:label "conditionConcept" ;
    rdfs:comment "Sự kiện ghi nhận khái niệm bệnh"@vi ;
    rdfs:domain pilot:ConditionOccurrence ;
    rdfs:range pilot:Disease .

pilot:considersResult a owl:ObjectProperty ;
    rdfs:label "considersResult" ;
    rdfs:comment "Đánh giá có xem xét kết quả cụ thể"@vi ;
    rdfs:domain pilot:ClinicalAssessment ;
    rdfs:range pilot:Result .

pilot:contactPIMention a owl:ObjectProperty ;
    rdfs:comment "PI name as reported; placeholders and incomplete lists remain explicitly marked."@en ;
    rdfs:domain pilot:GrantAward ;
    rdfs:range pilot:PersonNameMention .

pilot:controlRole a owl:DatatypeProperty ;
    rdfs:comment "Vai trò control theo nguồn"@vi ;
    rdfs:range xsd:string .

pilot:countingUnit a owl:DatatypeProperty ;
    rdfs:comment "patient/specimen/run/..."@vi ;
    rdfs:range xsd:string .

pilot:country a owl:DatatypeProperty ;
    rdfs:comment "Reported country; not inferred from other fields."@en ;
    rdfs:range xsd:string .

pilot:dateStatus a owl:DatatypeProperty ;
    rdfs:comment "original/shifted/generalized/relative/unknown"@vi ;
    rdfs:range xsd:string .

pilot:denominator a owl:DatatypeProperty ;
    rdfs:comment "Mẫu số thống kê"@vi ;
