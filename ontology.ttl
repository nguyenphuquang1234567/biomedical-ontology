pilot:CoinfectionAssessment a owl:Class ;
    rdfs:label "Coinfection Assessment"@en ;
    rdfs:comment "Design status: source-grounded",
        "Đồng nhiễm được nguồn đánh giá, không tự suy từ số taxon phát hiện."@vi ;
    rdfs:seeAlso <https://link.springer.com/article/10.1186/s12879-022-07381-8> ;
    rdfs:subClassOf pilot:DiagnosticAssessment .

pilot:ConditionOccurrence a owl:Class ;
    rdfs:label "Condition Occurrence"@en ;
    rdfs:comment "Design status: source-grounded",
        "Ghi nhận bệnh nền/chẩn đoán cho một người; khác với concept bệnh dùng chung."@vi ;
    rdfs:seeAlso <https://link.springer.com/article/10.1186/s12879-022-07381-8>,
        <https://www.frontiersin.org/journals/medicine/articles/10.3389/fmed.2023.1195629/full>,
        <https://www.nature.com/articles/s41597-025-06171-6> ;
    rdfs:subClassOf pilot:ClinicalEvent .

pilot:GrantDocument a owl:Class ;
    rdfs:label "GrantDocument" ;
    rdfs:comment "A grant project-detail record or abstract; not a claim that full grant text is available."@en ;
    rdfs:subClassOf pilot:Document .

pilot:Identifier a owl:Class ;
    rdfs:label "Identifier"@en ;
    rdfs:comment "Design status: source-grounded",
        "Mã external có namespace; BioSample/run/PMCID là các namespace khác nhau."@vi ;
    rdfs:seeAlso <https://datadryad.org/dataset/doi:10.5061/dryad.800tj>,
        <https://link.springer.com/article/10.1186/s12879-022-07381-8>,
        <https://pmc.ncbi.nlm.nih.gov/tools/openftlist/>,
        <https://www.frontiersin.org/journals/medicine/articles/10.3389/fmed.2023.1195629/full>,
        <https://www.nature.com/articles/s41597-025-06171-6> ;
    rdfs:subClassOf pilot:Entity .

pilot:Location a owl:Class ;
    rdfs:label "Location" ;
    rdfs:comment "Source-reported city, state and country for an organization; not necessarily the study site."@en ;
    rdfs:subClassOf pilot:Entity .

pilot:ProcessingPipeline a owl:Class ;
    rdfs:label "Processing Pipeline"@en ;
    rdfs:comment "Design status: source-grounded",
        "Pipeline/phần mềm/reference dùng tạo kết quả dẫn xuất."@vi ;
    rdfs:seeAlso <https://datadryad.org/dataset/doi:10.5061/dryad.800tj>,
        <https://www.nature.com/articles/s41597-025-06171-6> ;
    rdfs:subClassOf pilot:Entity .

pilot:QualityMetricResult a owl:Class ;
    rdfs:label "Quality Metric Result"@en ;
    rdfs:comment "Design status: source-grounded",
        "QC như Q20, Q30, clean rate, RMSE; gắn đúng đối tượng run/pipeline."@vi ;
    rdfs:seeAlso <https://www.nature.com/articles/s41597-025-06171-6> ;
    rdfs:subClassOf pilot:Result .

pilot:SequencingRun a owl:Class ;
    rdfs:label "Sequencing Run"@en ;
    rdfs:comment "Design status: source-grounded",
        "Một run SRA; khác patient, specimen và assay."@vi ;
    rdfs:seeAlso <https://link.springer.com/article/10.1186/s12879-022-07381-8>,
        <https://www.frontiersin.org/journals/medicine/articles/10.3389/fmed.2023.1195629/full>,
        <https://www.nature.com/articles/s41597-025-06171-6> ;
    rdfs:subClassOf pilot:Entity .

pilot:TaxonReference a owl:Class ;
    rdfs:label "TaxonReference" ;
    rdfs:comment "Unverified source taxon identifier(s) and label(s), preserving combined values without assuming namespace or alignment."@en ;
    rdfs:subClassOf pilot:Entity .

pilot:Treatment a owl:Class ;
    rdfs:label "Treatment"@en ;
    rdfs:comment "Design status: source-grounded",
        "Khái niệm điều trị dùng chung; không phải sự kiện điều trị từng người."@vi ;
    rdfs:seeAlso <https://link.springer.com/article/10.1186/s12879-022-07381-8>,
        <https://www.frontiersin.org/journals/medicine/articles/10.3389/fmed.2023.1195629/full> ;
    rdfs:subClassOf pilot:Entity .

pilot:AggregateStatistic a owl:Class ;
    rdfs:label "Aggregate Statistic"@en ;
    rdfs:comment "Design status: source-grounded",
        "Giá trị ở cấp nhóm, có mẫu số; không gán cho cá nhân."@vi ;
    rdfs:seeAlso <https://link.springer.com/article/10.1186/s12879-022-07381-8>,
        <https://www.frontiersin.org/journals/medicine/articles/10.3389/fmed.2023.1195629/full> ;
    rdfs:subClassOf pilot:Entity .

pilot:Citation a owl:Class ;
    rdfs:label "Citation"@en ;
    rdfs:comment "Design status: source-grounded",
        "Record trích dẫn có paper nguồn, reference text và target nếu resolve được."@vi ;
    rdfs:seeAlso <https://pmc.ncbi.nlm.nih.gov/tools/openftlist/> ;
    rdfs:subClassOf pilot:Entity .

pilot:DiagnosticAssessment a owl:Class ;
