        <https://example.org/nih-pilot/metadata/locator/stg_grant_funding.csv/1509/award_key>,
        <https://example.org/nih-pilot/metadata/locator/stg_grant_funding.csv/1509/award_notice_date>,
        <https://example.org/nih-pilot/metadata/locator/stg_grant_funding.csv/1509/fiscal_year>,
        <https://example.org/nih-pilot/metadata/locator/stg_grant_funding.csv/1509/project_detail_url>,
