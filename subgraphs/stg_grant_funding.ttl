    pilot:documentForFunding <https://example.org/nih-pilot/metadata/funding/11168545> ;
    pilot:label "Identifying placental tissue tropism and cellular mechanisms of Ebola Virus transmission from mother to fetus in pregnancy" ;
    pilot:recordedAt <https://example.org/nih-pilot/metadata/locator/stg_grant_funding.csv/2291/abstract_text>,
        <https://example.org/nih-pilot/metadata/locator/stg_grant_funding.csv/2291/appl_id>,
        <https://example.org/nih-pilot/metadata/locator/stg_grant_funding.csv/2291/award_amount>,
