        <https://example.org/nih-pilot/metadata/locator/stg_grant_funding.csv/1596/award_notice_date>,
        <https://example.org/nih-pilot/metadata/locator/stg_grant_funding.csv/1596/fiscal_year>,
        <https://example.org/nih-pilot/metadata/locator/stg_grant_funding.csv/1596/project_detail_url>,
        <https://example.org/nih-pilot/metadata/locator/stg_grant_funding.csv/1596/project_num>,
