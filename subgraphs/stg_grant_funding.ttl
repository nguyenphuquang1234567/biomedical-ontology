        <https://example.org/nih-pilot/metadata/locator/stg_grant_funding.csv/943/fiscal_year>,
        <https://example.org/nih-pilot/metadata/locator/stg_grant_funding.csv/943/project_detail_url>,
        <https://example.org/nih-pilot/metadata/locator/stg_grant_funding.csv/943/project_num>,
