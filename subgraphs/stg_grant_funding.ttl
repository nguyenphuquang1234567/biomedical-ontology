    pilot:sourceUrl "https://reporter.nih.gov/project-details/11190656" .

<https://example.org/nih-pilot/metadata/grantdocument/11190660> a pilot:GrantDocument ;
    pilot:abstractText "Project 1: We previously developed a NHP ICU model in healthy (uninfected) NHPs. We have extended this model to included supportive care of animals infected with E.coli or K. pneumoniae. Among K. pneumoniae infected animals, we have completed a bacterial dose-response study. The manuscript is has been submitted for publication and is undergoing peer-review. We are now proceeding with our first intervention trial with a host-targeted potential therapy for K. pnuemoniae sepsis. Additionally, we have completed a 2-animal pilot study providing supportive critical care to NHPs infected with Ebola virus. This study was successfully implemented in the NIAID biosafety-level (BSL)-4 Integrated Research Facility (IRF) in Fredrick, MD and has been published. In the coming year we will evaluate pathogenes of lower doses of EBOV infection in NHPs. The goal of this work will be to establish a model that more closes represents timing of severity of infection in humans." ;
    pilot:documentForFunding <https://example.org/nih-pilot/metadata/funding/11190660> ;
    pilot:label "Animal Models of Emerging Viral Infection" ;
    pilot:recordedAt <https://example.org/nih-pilot/metadata/locator/stg_grant_funding.csv/2309/abstract_text>,
        <https://example.org/nih-pilot/metadata/locator/stg_grant_funding.csv/2309/appl_id>,
        <https://example.org/nih-pilot/metadata/locator/stg_grant_funding.csv/2309/award_amount>,
        <https://example.org/nih-pilot/metadata/locator/stg_grant_funding.csv/2309/award_key>,
