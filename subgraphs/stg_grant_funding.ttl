        <https://example.org/nih-pilot/metadata/locator/stg_grant_funding.csv/1341/award_key>,
        <https://example.org/nih-pilot/metadata/locator/stg_grant_funding.csv/1341/award_notice_date>,
        <https://example.org/nih-pilot/metadata/locator/stg_grant_funding.csv/1341/fiscal_year>,
