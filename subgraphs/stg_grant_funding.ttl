        <https://example.org/nih-pilot/metadata/locator/stg_grant_funding.csv/1165/fiscal_year>,
        <https://example.org/nih-pilot/metadata/locator/stg_grant_funding.csv/1165/project_detail_url>,
        <https://example.org/nih-pilot/metadata/locator/stg_grant_funding.csv/1165/project_num>,
