        <https://example.org/nih-pilot/metadata/locator/stg_grant_funding.csv/1848/project_detail_url>,
        <https://example.org/nih-pilot/metadata/locator/stg_grant_funding.csv/1848/project_num>,
        <https://example.org/nih-pilot/metadata/locator/stg_grant_funding.csv/1848/project_title> ;
