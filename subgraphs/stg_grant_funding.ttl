        <https://example.org/nih-pilot/metadata/locator/stg_grant_funding.csv/936/award_notice_date>,
        <https://example.org/nih-pilot/metadata/locator/stg_grant_funding.csv/936/fiscal_year>,
        <https://example.org/nih-pilot/metadata/locator/stg_grant_funding.csv/936/project_detail_url>,
