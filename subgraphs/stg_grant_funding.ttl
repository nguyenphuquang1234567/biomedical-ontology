        <https://example.org/nih-pilot/metadata/locator/stg_grant_funding.csv/2245/award_key>,
        <https://example.org/nih-pilot/metadata/locator/stg_grant_funding.csv/2245/award_notice_date>,
        <https://example.org/nih-pilot/metadata/locator/stg_grant_funding.csv/2245/fiscal_year>,
        <https://example.org/nih-pilot/metadata/locator/stg_grant_funding.csv/2245/project_detail_url>,
