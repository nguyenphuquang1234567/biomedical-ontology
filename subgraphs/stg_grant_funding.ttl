        <https://example.org/nih-pilot/metadata/locator/stg_grant_funding.csv/598/fiscal_year>,
        <https://example.org/nih-pilot/metadata/locator/stg_grant_funding.csv/598/project_detail_url>,
        <https://example.org/nih-pilot/metadata/locator/stg_grant_funding.csv/598/project_num>,
        <https://example.org/nih-pilot/metadata/locator/stg_grant_funding.csv/598/project_title>,
