    pilot:label "Partnership for Research in Emerging Viral Infections-Sierra Leone (PREVSL)" ;
    pilot:recordedAt <https://example.org/nih-pilot/metadata/locator/stg_grant_funding.csv/2402/abstract_text>,
        <https://example.org/nih-pilot/metadata/locator/stg_grant_funding.csv/2402/appl_id>,
