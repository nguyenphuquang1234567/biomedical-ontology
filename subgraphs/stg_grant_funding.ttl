<https://example.org/nih-pilot/metadata/grantdocument/9355930> a pilot:GrantDocument ;
    pilot:abstractText "This contract provides for the development and standardization of small animal models for infectious diseases, and may include efficacy testing of candidate products." ;
    pilot:documentForFunding <https://example.org/nih-pilot/metadata/funding/9355930> ;
    pilot:label "TASK A94: Mouse Models for Therapeutics Testing Against Ebola Virus" ;
