        <https://example.org/nih-pilot/metadata/locator/stg_grant_funding.csv/1027/fiscal_year>,
        <https://example.org/nih-pilot/metadata/locator/stg_grant_funding.csv/1027/project_detail_url>,
        <https://example.org/nih-pilot/metadata/locator/stg_grant_funding.csv/1027/project_num>,
        <https://example.org/nih-pilot/metadata/locator/stg_grant_funding.csv/1027/project_title>,
        <https://example.org/nih-pilot/metadata/locator/stg_grant_funding.csv/1027/subproject_id> ;
    pilot:sourceUrl "https://reporter.nih.gov/project-details/9143280" .

