        <https://example.org/nih-pilot/metadata/locator/stg_grant_funding.csv/2031/fiscal_year>,
        <https://example.org/nih-pilot/metadata/locator/stg_grant_funding.csv/2031/project_detail_url>,
        <https://example.org/nih-pilot/metadata/locator/stg_grant_funding.csv/2031/project_num>,
