        <https://example.org/nih-pilot/metadata/locator/stg_grant_funding.csv/596/fiscal_year>,
        <https://example.org/nih-pilot/metadata/locator/stg_grant_funding.csv/596/project_detail_url>,
        <https://example.org/nih-pilot/metadata/locator/stg_grant_funding.csv/596/project_num>,
