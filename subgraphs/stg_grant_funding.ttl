        <https://example.org/nih-pilot/metadata/locator/stg_grant_funding.csv/1263/project_num>,
        <https://example.org/nih-pilot/metadata/locator/stg_grant_funding.csv/1263/project_title>,
        <https://example.org/nih-pilot/metadata/locator/stg_grant_funding.csv/1263/subproject_id> ;
