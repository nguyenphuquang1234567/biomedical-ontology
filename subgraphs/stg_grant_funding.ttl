        <https://example.org/nih-pilot/metadata/locator/stg_grant_funding.csv/2305/award_key>,
        <https://example.org/nih-pilot/metadata/locator/stg_grant_funding.csv/2305/fiscal_year>,
        <https://example.org/nih-pilot/metadata/locator/stg_grant_funding.csv/2305/project_detail_url>,
        <https://example.org/nih-pilot/metadata/locator/stg_grant_funding.csv/2305/project_num>,
        <https://example.org/nih-pilot/metadata/locator/stg_grant_funding.csv/2305/project_title> ;
