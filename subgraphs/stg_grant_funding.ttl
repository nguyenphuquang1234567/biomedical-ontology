        <https://example.org/nih-pilot/metadata/locator/stg_grant_funding.csv/253/award_notice_date>,
        <https://example.org/nih-pilot/metadata/locator/stg_grant_funding.csv/253/fiscal_year>,
        <https://example.org/nih-pilot/metadata/locator/stg_grant_funding.csv/253/project_detail_url>,
        <https://example.org/nih-pilot/metadata/locator/stg_grant_funding.csv/253/project_num>,
