        <https://example.org/nih-pilot/metadata/locator/stg_grant_funding.csv/1423/award_notice_date>,
        <https://example.org/nih-pilot/metadata/locator/stg_grant_funding.csv/1423/fiscal_year>,
        <https://example.org/nih-pilot/metadata/locator/stg_grant_funding.csv/1423/project_detail_url>,
        <https://example.org/nih-pilot/metadata/locator/stg_grant_funding.csv/1423/project_num>,
        <https://example.org/nih-pilot/metadata/locator/stg_grant_funding.csv/1423/project_title>,
        <https://example.org/nih-pilot/metadata/locator/stg_grant_funding.csv/1423/subproject_id> ;
