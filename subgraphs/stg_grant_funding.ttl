        <https://example.org/nih-pilot/metadata/locator/stg_grant_funding.csv/2382/award_key>,
        <https://example.org/nih-pilot/metadata/locator/stg_grant_funding.csv/2382/award_notice_date>,
        <https://example.org/nih-pilot/metadata/locator/stg_grant_funding.csv/2382/fiscal_year>,
        <https://example.org/nih-pilot/metadata/locator/stg_grant_funding.csv/2382/project_detail_url>,
