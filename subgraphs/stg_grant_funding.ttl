        <https://example.org/nih-pilot/metadata/locator/stg_grant_funding.csv/1184/fiscal_year>,
        <https://example.org/nih-pilot/metadata/locator/stg_grant_funding.csv/1184/project_detail_url>,
        <https://example.org/nih-pilot/metadata/locator/stg_grant_funding.csv/1184/project_num>,
        <https://example.org/nih-pilot/metadata/locator/stg_grant_funding.csv/1184/project_title> ;
    pilot:sourceUrl "https://reporter.nih.gov/project-details/9354784" .

<https://example.org/nih-pilot/metadata/grantdocument/9354851> a pilot:GrantDocument ;
    pilot:abstractText """Development and characterization of anti-EBOV RITs
In collaboration with Dr. Jens Kuhn and Dr. Peter Jahrling of the NIAID Integrated Research Facility, we have produced a Pseudomonas exotoxin A-based RIT based on an scFv from a mAb against the EBOV GP. In FY2016, this RIT was examined in the BSL-4 facility and found to suppress EBOV infection in cell culture. However the potency not as strong as has been achieved with our anti-HIV RITs. Studies are underway to examine the effects of this RIT against an EBOV GP transfectant cell line.""" ;
    pilot:documentForFunding <https://example.org/nih-pilot/metadata/funding/9354851> ;
    pilot:label "Targeted Killing of Herpesvirus-Infected Cells and Ebola Virus-Infected Cells" ;
    pilot:recordedAt <https://example.org/nih-pilot/metadata/locator/stg_grant_funding.csv/1185/abstract_text>,
        <https://example.org/nih-pilot/metadata/locator/stg_grant_funding.csv/1185/appl_id>,
