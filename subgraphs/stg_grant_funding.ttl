        <https://example.org/nih-pilot/metadata/locator/stg_grant_funding.csv/325/award_key>,
        <https://example.org/nih-pilot/metadata/locator/stg_grant_funding.csv/325/fiscal_year>,
        <https://example.org/nih-pilot/metadata/locator/stg_grant_funding.csv/325/project_detail_url>,
        <https://example.org/nih-pilot/metadata/locator/stg_grant_funding.csv/325/project_num>,
