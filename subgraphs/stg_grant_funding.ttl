        <https://example.org/nih-pilot/metadata/locator/stg_grant_funding.csv/326/fiscal_year>,
        <https://example.org/nih-pilot/metadata/locator/stg_grant_funding.csv/326/project_detail_url>,
        <https://example.org/nih-pilot/metadata/locator/stg_grant_funding.csv/326/project_num>,
        <https://example.org/nih-pilot/metadata/locator/stg_grant_funding.csv/326/project_title>,
