        <https://example.org/nih-pilot/metadata/locator/stg_grant_funding.csv/735/award_key>,
        <https://example.org/nih-pilot/metadata/locator/stg_grant_funding.csv/735/award_notice_date>,
        <https://example.org/nih-pilot/metadata/locator/stg_grant_funding.csv/735/fiscal_year>,
        <https://example.org/nih-pilot/metadata/locator/stg_grant_funding.csv/735/project_detail_url>,
