        <https://example.org/nih-pilot/metadata/locator/stg_grant_funding.csv/1869/award_notice_date>,
        <https://example.org/nih-pilot/metadata/locator/stg_grant_funding.csv/1869/fiscal_year>,
        <https://example.org/nih-pilot/metadata/locator/stg_grant_funding.csv/1869/project_detail_url>,
        <https://example.org/nih-pilot/metadata/locator/stg_grant_funding.csv/1869/project_num>,
        <https://example.org/nih-pilot/metadata/locator/stg_grant_funding.csv/1869/project_title>,
        <https://example.org/nih-pilot/metadata/locator/stg_grant_funding.csv/1869/subproject_id> ;
