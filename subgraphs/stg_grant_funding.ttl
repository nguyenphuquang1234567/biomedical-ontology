        <https://example.org/nih-pilot/metadata/locator/stg_grant_funding.csv/2035/fiscal_year>,
        <https://example.org/nih-pilot/metadata/locator/stg_grant_funding.csv/2035/project_detail_url>,
        <https://example.org/nih-pilot/metadata/locator/stg_grant_funding.csv/2035/project_num>,
