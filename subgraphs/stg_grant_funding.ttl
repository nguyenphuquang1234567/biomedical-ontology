<https://example.org/nih-pilot/metadata/grantdocument/8542474> a pilot:GrantDocument ;
    pilot:abstractText "The immune response against filoviruses is poorly understood, and there is a need to determine correlates of protection that could be used for vaccine development. This IAA will examine T cell immunity to the Zaire-Ebola virus and establish potential correlates of immunity using tetramer technology and cytotoxic T lymphocyte assays under BSL-2 conditions." ;
    pilot:documentForFunding <https://example.org/nih-pilot/metadata/funding/8542474> ;
    pilot:label "Development of anti-Ebola MHC tetramers as a surrogate marker" ;
    pilot:recordedAt <https://example.org/nih-pilot/metadata/locator/stg_grant_funding.csv/663/abstract_text>,
        <https://example.org/nih-pilot/metadata/locator/stg_grant_funding.csv/663/appl_id>,
