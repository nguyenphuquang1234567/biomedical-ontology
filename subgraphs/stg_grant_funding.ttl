        <https://example.org/nih-pilot/metadata/locator/stg_grant_funding.csv/486/award_key>,
        <https://example.org/nih-pilot/metadata/locator/stg_grant_funding.csv/486/award_notice_date>,
        <https://example.org/nih-pilot/metadata/locator/stg_grant_funding.csv/486/fiscal_year>,
        <https://example.org/nih-pilot/metadata/locator/stg_grant_funding.csv/486/project_detail_url>,
