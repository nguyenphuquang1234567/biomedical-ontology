        <https://example.org/nih-pilot/metadata/locator/stg_grant_funding.csv/2334/award_notice_date>,
        <https://example.org/nih-pilot/metadata/locator/stg_grant_funding.csv/2334/fiscal_year>,
        <https://example.org/nih-pilot/metadata/locator/stg_grant_funding.csv/2334/project_detail_url>,
