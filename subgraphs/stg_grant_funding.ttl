        <https://example.org/nih-pilot/metadata/locator/stg_grant_funding.csv/1394/award_notice_date>,
        <https://example.org/nih-pilot/metadata/locator/stg_grant_funding.csv/1394/fiscal_year>,
        <https://example.org/nih-pilot/metadata/locator/stg_grant_funding.csv/1394/project_detail_url>,
        <https://example.org/nih-pilot/metadata/locator/stg_grant_funding.csv/1394/project_num>,
        <https://example.org/nih-pilot/metadata/locator/stg_grant_funding.csv/1394/project_title>,
        <https://example.org/nih-pilot/metadata/locator/stg_grant_funding.csv/1394/subproject_id> ;
