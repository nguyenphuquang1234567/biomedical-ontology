        <https://example.org/nih-pilot/metadata/locator/stg_grant_funding.csv/760/award_amount>,
        <https://example.org/nih-pilot/metadata/locator/stg_grant_funding.csv/760/award_key>,
        <https://example.org/nih-pilot/metadata/locator/stg_grant_funding.csv/760/fiscal_year>,
        <https://example.org/nih-pilot/metadata/locator/stg_grant_funding.csv/760/project_detail_url>,
        <https://example.org/nih-pilot/metadata/locator/stg_grant_funding.csv/760/project_num>,
