        <https://example.org/nih-pilot/metadata/locator/stg_grant_funding.csv/1018/fiscal_year>,
        <https://example.org/nih-pilot/metadata/locator/stg_grant_funding.csv/1018/project_detail_url>,
        <https://example.org/nih-pilot/metadata/locator/stg_grant_funding.csv/1018/project_num>,
