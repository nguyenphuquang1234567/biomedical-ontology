        <https://example.org/nih-pilot/metadata/locator/stg_grant_funding.csv/1825/award_key>,
        <https://example.org/nih-pilot/metadata/locator/stg_grant_funding.csv/1825/fiscal_year>,
        <https://example.org/nih-pilot/metadata/locator/stg_grant_funding.csv/1825/project_detail_url>,
        <https://example.org/nih-pilot/metadata/locator/stg_grant_funding.csv/1825/project_num>,
        <https://example.org/nih-pilot/metadata/locator/stg_grant_funding.csv/1825/project_title> ;
    pilot:sourceUrl "https://reporter.nih.gov/project-details/10262626" .

<https://example.org/nih-pilot/metadata/grantdocument/10262631> a pilot:GrantDocument ;
    pilot:abstractText "Project 1: Clinical data was abstracted from the medical record. Magnetic resonance imaging of brain and heart was performed early and late during convalescence. Daily blood specimens (serum, plasma, leukocytes) and intermittent body fluid specimens (urine, stool, semen) were collected, preserved, and stored at the NIAID IRF BSL 4 laboratory for later analysis. Our prior published work described the peripheral blood leukocyte transcriptional responses during illness and recovery correlated with clinical parameters and viral kinetics and genetic diversification in serum during acute illness and in semen during convalescence. Building on this work, we performed a longitudinal analysis of the antibody response to each of the 7 Ebola virus proteins during acute illness and convalescence by surface plasmin resonance and gene fragment phage display analyses. Additionally, we described the kinetics of viral RNA in multiple body compartments and used this data to highlight the mathematical modeling challenges of Ebola virus-host dynamics during infection and treatment." ;
    pilot:documentForFunding <https://example.org/nih-pilot/metadata/funding/10262631> ;
    pilot:label "Clinical and Molecular Features of Ebola Virus Disease" ;
    pilot:recordedAt <https://example.org/nih-pilot/metadata/locator/stg_grant_funding.csv/1826/abstract_text>,
        <https://example.org/nih-pilot/metadata/locator/stg_grant_funding.csv/1826/appl_id>,
