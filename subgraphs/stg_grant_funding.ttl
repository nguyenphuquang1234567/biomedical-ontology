        <https://example.org/nih-pilot/metadata/locator/stg_grant_funding.csv/1190/award_key>,
        <https://example.org/nih-pilot/metadata/locator/stg_grant_funding.csv/1190/fiscal_year>,
        <https://example.org/nih-pilot/metadata/locator/stg_grant_funding.csv/1190/project_detail_url>,
        <https://example.org/nih-pilot/metadata/locator/stg_grant_funding.csv/1190/project_num>,
        <https://example.org/nih-pilot/metadata/locator/stg_grant_funding.csv/1190/project_title> ;
