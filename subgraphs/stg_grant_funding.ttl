        <https://example.org/nih-pilot/metadata/locator/stg_grant_funding.csv/507/award_key>,
        <https://example.org/nih-pilot/metadata/locator/stg_grant_funding.csv/507/award_notice_date>,
        <https://example.org/nih-pilot/metadata/locator/stg_grant_funding.csv/507/fiscal_year>,
        <https://example.org/nih-pilot/metadata/locator/stg_grant_funding.csv/507/project_detail_url>,
        <https://example.org/nih-pilot/metadata/locator/stg_grant_funding.csv/507/project_num>,
