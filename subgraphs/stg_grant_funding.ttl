        <https://example.org/nih-pilot/metadata/locator/stg_grant_funding.csv/1055/award_key>,
        <https://example.org/nih-pilot/metadata/locator/stg_grant_funding.csv/1055/award_notice_date>,
        <https://example.org/nih-pilot/metadata/locator/stg_grant_funding.csv/1055/fiscal_year>,
        <https://example.org/nih-pilot/metadata/locator/stg_grant_funding.csv/1055/project_detail_url>,
