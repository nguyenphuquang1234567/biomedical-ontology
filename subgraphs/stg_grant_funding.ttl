        <https://example.org/nih-pilot/metadata/locator/stg_grant_funding.csv/1436/award_notice_date>,
        <https://example.org/nih-pilot/metadata/locator/stg_grant_funding.csv/1436/fiscal_year>,
        <https://example.org/nih-pilot/metadata/locator/stg_grant_funding.csv/1436/project_detail_url>,
