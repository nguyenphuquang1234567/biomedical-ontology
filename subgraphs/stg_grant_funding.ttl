        <https://example.org/nih-pilot/metadata/locator/stg_grant_funding.csv/583/subproject_id> ;
    pilot:sourceUrl "https://reporter.nih.gov/project-details/8357692" .

<https://example.org/nih-pilot/metadata/grantdocument/8357705> a pilot:GrantDocument ;
    pilot:abstractText """This subproject is one of many research subprojects utilizing the resources
