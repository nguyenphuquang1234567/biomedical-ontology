        <https://example.org/nih-pilot/metadata/locator/stg_grant_funding.csv/306/fiscal_year>,
        <https://example.org/nih-pilot/metadata/locator/stg_grant_funding.csv/306/project_detail_url>,
        <https://example.org/nih-pilot/metadata/locator/stg_grant_funding.csv/306/project_num>,
        <https://example.org/nih-pilot/metadata/locator/stg_grant_funding.csv/306/project_title>,
        <https://example.org/nih-pilot/metadata/locator/stg_grant_funding.csv/306/subproject_id> ;
