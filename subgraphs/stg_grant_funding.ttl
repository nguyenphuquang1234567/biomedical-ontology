        <https://example.org/nih-pilot/metadata/locator/stg_grant_funding.csv/234/project_detail_url>,
        <https://example.org/nih-pilot/metadata/locator/stg_grant_funding.csv/234/project_num>,
        <https://example.org/nih-pilot/metadata/locator/stg_grant_funding.csv/234/project_title> ;
